<?xml version="1.0" encoding="utf-8"?>
<!-- Native start screen (shown before Flutter starts): same blue-to-pink colours as the logo splash -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#FF0A5CFF"
                android:centerColor="#FF2C1BF0"
                android:endColor="#FFE00BCB"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
